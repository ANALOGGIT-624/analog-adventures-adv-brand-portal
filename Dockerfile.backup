FROM node:22-bookworm-slim AS dependencies
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY extensions/brand-portal/package.json ./extensions/brand-portal/package.json
RUN npm ci --omit=dev --ignore-scripts
COPY prisma-postgresql ./prisma-postgresql
RUN npx prisma generate --schema prisma-postgresql/schema.prisma

FROM postgres:18-bookworm
COPY --from=dependencies /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY scripts/recovery ./scripts/recovery
COPY app/lib/coordinated-session-storage.server.js app/lib/private-artwork-storage.server.js app/lib/proof-workflow.server.js app/lib/brand-portal.server.js app/lib/portal-records.server.js ./app/lib/
COPY shopify.app.toml ./shopify.app.toml
COPY prisma/schema.prisma ./prisma/schema.prisma
USER postgres
ENTRYPOINT ["node"]
CMD ["scripts/recovery/scheduled-all.mjs"]
